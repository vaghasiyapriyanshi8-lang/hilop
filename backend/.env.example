NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://mongo:27017/hilop
REDIS_URI=redis://redis:6379
JWT_SECRET=replace_with_secure_random
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_secure_random
REFRESH_TOKEN_EXPIRES_IN=30d
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
STRIPE_SECRET_KEY=your-stripe-key
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
GOOGLE_CLIENT_ID=your-google-client-id
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=your-user
EMAIL_PASSWORD=your-password
FRONTEND_URL=https://admin.hilop.com
MOBILE_APP_URL=https://app.hilop.com
